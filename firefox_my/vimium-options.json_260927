{
  "exclusionRules": [],
  "keyMappings": "map <C-d> scrollPageDown\nmap <C-u> scrollPageUp\nmap J nextTab\nmap k previousTab\nmap <C-r> reload\nmap r reload hard\n#map R reload hard",
  "newTabCustomUrl": "https://start.duckduckgo.com",
  "newTabDestination": "customUrl",
  "openVomnibarOnNewTabPage": false,
  "scrollStepSize": 140,
  "settingsVersion": "2.4.2",
  "smoothScroll": false
}
