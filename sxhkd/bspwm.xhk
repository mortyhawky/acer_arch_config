# vim: set filetype=xhk :

## ####################################
##  BackSpace
##  Escape
##  Return
##  Space
##  Tab
#    Capitalized
#   -----------------------------------
##  alt
##  ctrl
##  shift
##  super
#    lowercase, (X keysym conventions)
## ####################################

super + Escape
    bspc wm -r

ctrl + Escape
    pkill -SIGUSR1 --exact sxhkd


#    pkill -SIGUSR1 --exact sxhkd
##super + ctrl + r    ## Reload sxhkd
##    pkill -USR1 -x sxhkd
#
#super + shift + r   ## Reload bspwm
#    bspc wm -r
#

super + r
    rofi -modi drun,run -show drun
    #rofi -modi drun,run -show drun -show-icons

ctrl + super + F8
    env > ~/.config/sxhkd/sxhkd-env

super + Return
    /usr/bin/alacritty

super + w
    /usr/bin/firefox

#                              "instance","class"
super + b
    /usr/bin/alacritty --class alac_btop,alac_btop -e /usr/bin/btop


## ###############################################
##   BSPWM   HOTKEYS
## ###############################################

## focus the node in the given direction
super + {h,j,k,l}
	bspc node --focus {west,south,north,east}

# Resize window (Super + Shift + hl)
# Resize focused window - Horizontal (h = narrower, l = wider)
super + shift + h
    bspc node --resize left -20 0 || bspc node -z right -20 0

super + shift + l
    bspc node -z right 20 0 || bspc node -z left 20 0

# Resize window (Super + Shift + jk)
# Resize focused window - Vertical (j = shorter, k = taller)
super + shift + j
    bspc node -z bottom 0 20 || bspc node -z top 0 20

super + shift + k
    bspc node -z top 0 -20 || bspc node -z bottom 0 -20

## Close focused window
super + q
  bspc node --close

## quit bspwm
super + shift + q
  bspc quit

## alternate between the tiled and monocle layout
super + m
	bspc desktop -l next
super + t
	bspc desktop -l next

## Promote window
super + shift + Return
  bspc node --swap biggest.local

# focus or send to the given desktop
# Super + 1-9,0 go to desktop 
# Super + Shift + 1-9,0 send node to given desktop
super + {_, shift + }{1-9,0}
	bspc {desktop --focus, node --to-desktop} '^{1-9,10}'
