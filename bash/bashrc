#!/usr/bin/env bash
printf "~/.bashrc\n"

# see also the settings in ~/.config/readline/
# readline also works with gdb

# Load modular components
for file in ~/.config/bash/{aliases,exports,functions,completion,prompt}; do
    [ -f "$file" ] && source "$file"
done


# Make ctrl+s useable
stty    -ixon
#xset    r rate 250 40

#################################################
##  DEBUG
#################################################
source ~/.config/bash/debug
source ~/.config/bash/important
