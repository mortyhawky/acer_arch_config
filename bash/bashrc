#!/usr/bin/env bash
if [[ "$DEBUG" == "true" ]]; then
    #         1         2         3         4         5         6  
    #1234567890123456789012345678901234567890123456789012345678901234567890
    printf "~/.bashrc       -> ~/.config/bash/bashrc         \$- $-\n"
fi

# See also the settings in ~/.config/readline/
# Readline also works with GDB


# Load modular components
for file in ~/.config/bash/{exports,aliases,completion,exports,functions,prompt,debug,important}
#for file in ~/.config/bash/{exports,aliases,completion,exports,functions,prompt}
do
    #printf 'file = <%s>\n' "$file"
    #printf 'exists = '
    #[ -f "$file" ] && echo yes || echo no

    [ -f "$file" ] && source "$file"
done


# Make ctrl+s useable
stty    -ixon
